# ============================================
# Environment Variables Template
# ============================================
# Copy this file to .env and update the values
# cp .env.example .env

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=iwings
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@db:5432/iwings

# ============================================
# Backend Configuration
# ============================================
# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings
ALLOWED_ORIGINS=http://135.235.194.170:3000,http://135.235.194.170:8000

# ============================================
# Frontend Configuration
# ============================================
# API URL (used by Next.js)
NEXT_PUBLIC_API_URL=http://135.235.194.170:8000

# Node Environment
NODE_ENV=production

# ============================================
# Optional: External Services
# ============================================
# OpenAI API (if needed)
# OPENAI_API_KEY=your-openai-api-key

# Redis (if needed)
# REDIS_URL=redis://135.235.194.170:6379

# Email Service (if needed)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ============================================
# Docker Configuration
# ============================================
# Container Names
DB_CONTAINER_NAME=iwings_db
BACKEND_CONTAINER_NAME=iwings_backend
FRONTEND_CONTAINER_NAME=iwings_frontend

# Network Name
NETWORK_NAME=iwings_network

# Volume Name
VOLUME_NAME=postgres_data

# ============================================
# Development vs Production
# ============================================
# Set to 'development' for dev mode, 'production' for prod
ENVIRONMENT=production

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ============================================
# Notes
# ============================================
# 1. Never commit the actual .env file to version control
# 2. Update SECRET_KEY with a strong random value for production
# 3. Change default passwords before deploying to production
# 4. Use environment-specific values for different deployments
# 5. Keep sensitive data secure and use secrets management in production
